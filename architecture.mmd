flowchart LR
  subgraph SRC[Fonti aperte]
    WD[Wikidata CC0]
    EEA[EEA CO2 CC BY 4.0]
    RDW[RDW NL Public Domain]
    TRF[Traficom FI CC BY 4.0]
  end
  subgraph PIPE[pipeline - batch offline]
    IMP[Importer per fonte]
    VAL[Validazione qualita]
    MRG[Merge e verifica]
    EXP[Export dataset]
  end
  subgraph CORE[core - condiviso]
    MOD[Modelli Pydantic]
    STO[Storage SQLite]
  end
  subgraph SVC[service - deploy Render]
    API[API REST FastAPI]
    MCP[Server MCP]
    SITE[Pagine web: ricerca, sfoglia, copertura]
  end
  GH[GitHub Releases]
  USR[Persone, app, agenti, sviluppatori]
  GA[GitHub Actions: refresh mensile]

  WD --> IMP
  EEA --> IMP
  RDW --> IMP
  TRF --> IMP
  IMP --> VAL --> MRG --> STO
  MOD --- IMP
  MOD --- STO
  STO --> EXP --> GH
  GH -->|dataset dell'immagine Docker| SVC
  STO -.-> API
  STO -.-> MCP
  API --- SITE
  GA -->|costruisce e confronta| PIPE
  GA -.->|pubblica e apre una PR| GH
  USR --> API
  USR --> MCP
  USR --> SITE
  USR -->|scarica| GH
